{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gdietsch/trading-signals-mcp",
  "description": "x402 pay-per-call trading tools: pre-trade check, event gate, event study, insider buys, token check",
  "repository": {
    "url": "https://github.com/gdietsch/trading-signals-mcp",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "x402-trading-signals-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "X402_PRIVATE_KEY",
          "description": "Private key of a dedicated low-balance Base wallet holding USDC (pays per call)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MAX_USD_PER_CALL",
          "description": "Per-call spend cap in USD (default 0.50)",
          "isRequired": false,
          "format": "string",
          "default": "0.50"
        }
      ]
    }
  ]
}