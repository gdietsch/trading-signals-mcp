{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gdietsch/trading-signals-mcp",
  "description": "Trading tools for agents: AI trade brief, pre-trade check, event gate, insider buys. Remote or x402",
  "repository": {
    "url": "https://github.com/gdietsch/trading-signals-mcp",
    "source": "github"
  },
  "version": "0.1.13",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "x402-trading-signals-mcp",
      "version": "0.1.13",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "X402_PRIVATE_KEY",
          "description": "Private key of a dedicated low-balance Base wallet holding USDC (pays per call)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MAX_USD_PER_CALL",
          "description": "Per-call spend cap in USD (default 0.50)",
          "isRequired": false,
          "format": "string",
          "default": "0.50"
        },
        {
          "name": "TRADING_SIGNALS_BASE_URL",
          "description": "API base URL (default https://signals.incomefather.com)",
          "isRequired": false,
          "format": "string",
          "default": "https://signals.incomefather.com"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://signals.incomefather.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional: Bearer tsk_... API key (free 100 calls/month at https://signals.incomefather.com/pricing). Without it a small anonymous daily allowance applies.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
